<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />

  <title>
    {{.Subject}}
  </title>

  <style type="text/css">
    /* Base */
    body,.ExternalClass,.ReadMsgBody { background-color:#0d1117 }
    .email-wrap { max-width:600px;margin:40px auto;font-family:'JetBrains Mono','Fira Code','Consolas','Courier New',monospace }

    /* Header */
    .email-logo { display:block;margin:0 auto 14px;border:0;outline:none;opacity:0.5 }
    .email-brand { font-size:16px;font-weight:700;color:#00ff41;letter-spacing:0.5px }
    .email-header { padding:24px 28px 16px;text-align:left;border-bottom:2px solid #30363d;background:#161b22 }

    /* Card */
    .email-card { padding:28px 28px 20px;background:#161b22;color:#c9d1d9 }
    .email-heading { margin:0 0 12px;font-size:15px;font-weight:400;color:#58a6ff;line-height:1.6 }
    .email-text { margin:0 0 8px;font-size:14px;line-height:1.6;color:#c9d1d9;font-weight:400 }
    .email-subtext { margin:0 0 20px;font-size:14px;line-height:1.6;color:#8b949e;font-weight:400 }

    /* Divider */
    .email-divider { height:2px;background:#30363d;margin:0 }

    /* Button */
    .email-btn-row { padding:28px 28px 20px;text-align:left;background:#161b22 }
    .email-btn { display:inline-block;padding:11px 24px;font-size:14px;font-weight:700;color:#0d1117!important;text-decoration:none;background-color:#00ff41;border:2px solid #00ff41;font-family:'JetBrains Mono','Fira Code','Consolas',monospace;letter-spacing:0.5px }
    .email-btn-table { margin:24px 0 20px;border-collapse:separate }

    /* Fallback link */
    .email-link-box { background:#0d1117;border:1px solid #30363d;margin:20px 0 12px }
    .email-link-label { margin:0 0 6px;font-size:12px;color:#8b949e;font-weight:400 }
    .email-link-url { margin:0;font-size:12px;color:#58a6ff;word-break:break-all;line-height:1.6 }

    /* Footer */
    .email-footer { padding:16px 28px 20px;text-align:left;border-top:1px solid #30363d;background:#0d1117 }
    .email-footer-text { margin:0;font-size:12px;color:#484f58;font-weight:400 }
    .email-footer-link { color:#58a6ff;text-decoration:none;font-weight:400 }

    /* Typography utilities */
    .card-body h1,.card-body h2,.card-body h3,.card-body h4,.card-body h5,.card-body h6 { color:#58a6ff!important }
    .card-body a,.card-body a:link,.card-body a:visited { color:#58a6ff!important;text-decoration:underline!important }
    .card-body a:hover,.card-body a:active { color:#79c0ff!important }
    .card-body li { color:#c9d1d9!important }

    /* Responsive */
    @media only screen and (max-width:480px) {
      .email-card { padding:20px 16px!important }
      .email-btn-row { padding:20px 16px!important }
      .email-heading { font-size:14px!important }
    }
  </style>
</head>

<body style="margin:0;padding:0;background:#0d1117;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <center style="width:100%;table-layout:fixed;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" class="email-wrap">

      <!-- Floating Title -->
      <tr>
        <td class="email-header">

          <span class="email-brand">&gt; {{AppName}}</span>

        </td>
      </tr>

      <!-- Card -->
      <tr>
        <td class="email-card card-body">

          <p class="email-heading"></p>

          <p class="email-text">
            {{$release_url := HTMLFormat "<a href=\047%s\047>%s</a>" .Release.HTMLURL .Release.TagName}}
            {{$repo_url := HTMLFormat "<a href=\047%s\047>%s</a>" .Release.Repo.HTMLURL .Release.Repo.FullName}}
            {{.locale.Tr "mail.release.new.text" .Release.Publisher.Name $release_url $repo_url}}

            <h4>{{.locale.Tr "mail.release.title" .Release.Title}}</h4>

            <p>$ {{.locale.Tr "mail.release.note"}}</p>
            {{if .Release.RenderedNote}}
              <div style="margin:12px 0 16px;font-size:14px;line-height:1.6;color:#c9d1d9;">
                {{.Release.RenderedNote}}
              </div>
            {{end}}

            <p style="font-weight:700;color:#58a6ff;">{{.locale.Tr "mail.release.downloads"}}</p>
            <ul>
              {{if not .DisableDownloadSourceArchives}}
                <li><a href="{{.Release.Repo.HTMLURL}}/archive/{{.Release.TagName | PathEscapeSegments}}.zip">{{.locale.Tr "mail.release.download.zip"}}</a></li>
                <li><a href="{{.Release.Repo.HTMLURL}}/archive/{{.Release.TagName | PathEscapeSegments}}.tar.gz">{{.locale.Tr "mail.release.download.targz"}}</a></li>
              {{end}}
              {{if .Release.Attachments}}
                {{range .Release.Attachments}}
                  <li><a href="{{.DownloadURL}}">{{.Name}} ({{.Size | FileSize}})</a></li>
                {{end}}
              {{end}}
            </ul>
          </p>

          <p class="email-subtext"></p>

        </td>
      </tr>

      <!-- Divider -->
      <tr>
        <td class="email-divider"></td>
      </tr>

      <!-- Button & Link -->
      <tr>
        <td class="email-btn-row">

          <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-btn-table">
            <tr>
              <td align="left">
                <a href="{{.Link}}" class="email-btn">{{.locale.Tr "mail.view_it_on" AppName}}</a>
              </td>
            </tr>
          </table>

          <table width="100%" cellpadding="0" cellspacing="0" border="0" class="email-link-box">
            <tr>
              <td style="padding:14px 16px;">
                <p class="email-link-label">{{.locale.Tr "mail.link_not_working_do_paste"}}</p>
                <p class="email-link-url">
                  ┌─<br>
                  │ {{.Link}}<br>
                  └─
                </p>
              </td>
            </tr>
          </table>

        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td class="email-footer">

          <p class="email-footer-text">
            <span style="color:#8b949e;">#</span> &copy;
            <a href="{{AppUrl}}" class="email-footer-link">{{AppName}}</a>
          </p>

          <p class="email-footer-text" style="margin:4px 0 0;font-size:11px;">
            <span style="color:#8b949e;">#</span> if (!$expecting) { ignore(); }
          </p>

        </td>
      </tr>

    </table>
  </center>
</body>
</html>