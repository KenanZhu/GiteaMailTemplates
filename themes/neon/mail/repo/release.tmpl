<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />

  <title>
    {{.Subject}}
  </title>

  <style type="text/css">
    /* Base */
    body,.ExternalClass,.ReadMsgBody { background-color:#0a0a0f }
    .email-wrap { max-width:600px;margin:40px auto;font-family:system-ui,-apple-system,sans-serif;background:#0d0d18;border:1px solid #ff2d95;box-shadow:0 0 20px rgba(255,45,149,0.3),0 0 60px rgba(0,212,255,0.1) }

    /* Header */
    .email-logo { display:block;margin:0 auto 14px;border:0;outline:none;opacity:0.5 }
    .email-brand { font-size:20px;font-weight:900;color:#fff;letter-spacing:3px;text-transform:uppercase }
    .email-header { padding:0;background:linear-gradient(160deg,#ff2d95 28%,#0d0d18 28.5%);height:72px;text-align:right;vertical-align:bottom }

    /* Card */
    .email-card { padding:8px 32px 24px;color:#cbd5e1 }
    .email-heading { margin:0 0 20px;font-size:15px;font-weight:600;color:#00d4ff;line-height:1.3 }
    .email-text { margin:0 0 24px;font-size:14px;line-height:1.7;color:#cbd5e1;font-weight:400 }
    .email-subtext { margin:0;font-size:13px;line-height:1.6;color:#64748b;font-weight:400 }

    /* Divider */
    .email-divider { height:1px;background:linear-gradient(90deg,transparent,rgba(255,45,149,0.3),transparent) }

    /* Button */
    .email-btn-row { padding:40px 40px;text-align:center }
    .email-btn { display:inline-block;padding:13px 36px;font-size:14px;font-weight:700;color:#0a0a0f;text-decoration:none;background:linear-gradient(135deg,#ff2d95,#e0115f);border:1px solid #ff2d95;box-shadow:0 0 16px rgba(255,45,149,0.4);letter-spacing:1px;text-transform:uppercase }
    .email-btn-table { margin:0 0 24px }

    /* Fallback link */
    .email-link-box { border:1px solid rgba(0,212,255,0.2);background:rgba(0,212,255,0.04) }
    .email-link-label { margin:0 0 8px;font-size:12px;color:#64748b;font-weight:400 }
    .email-link-url { margin:0;font-size:11px;font-family:monospace;color:#00d4ff;background:rgba(0,0,0,0.3);padding:8px 10px;border:1px solid rgba(0,212,255,0.15);word-break:break-all }

    /* Footer */
    .email-footer { padding:16px 32px;border-top:1px solid rgba(255,45,149,0.15);background:rgba(255,45,149,0.03);text-align:center }
    .email-footer-text { margin:0;font-size:11px;color:#475569;font-weight:400 }
    .email-footer-link { color:#ff2d95;text-decoration:none;font-weight:600 }

    /* Typography utilities */
    .card-body h1,.card-body h2,.card-body h3,.card-body h4,.card-body h5,.card-body h6 { color:#00d4ff!important }
    .card-body a,.card-body a:link,.card-body a:visited { color:#ff2d95!important;text-decoration:underline!important }
    .card-body a:hover,.card-body a:active { color:#ff6db5!important }
    .card-body li { color:#cbd5e1!important }
    .card-body code,.card-body pre { color:#00d4ff;background:rgba(0,0,0,0.3);border:1px solid rgba(0,212,255,0.15) }
    .card-body blockquote { color:rgba(255,255,255,0.6);border-left:2px solid rgba(0,212,255,0.2);padding-left:1em;margin:1em 0 }
    .card-body hr { border-color:rgba(255,45,149,0.3) }

    /* Responsive */
    @media only screen and (max-width:480px) {
      .email-card { padding:32px 20px!important }
      .email-btn-row { padding:24px 20px!important }
      .email-heading { font-size:14px!important }
    }
  </style>
</head>

<body style="margin:0;padding:0;background:#0a0a0f;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <center style="width:100%;table-layout:fixed;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" class="email-wrap">

      <!-- Floating Title -->
      <tr>
        <td class="email-header">

          <span class="email-brand">{{AppName}}</span>

        </td>
      </tr>

      <!-- Card -->
      <tr>
        <td class="email-card card-body">

          <p class="email-heading"></p>

          <p class="email-text">
            {{$release_url := HTMLFormat "<a href=\047%s\047>%s</a>" .Release.HTMLURL .Release.TagName}}
            {{$repo_url := HTMLFormat "<a href=\047%s\047>%s</a>" .Release.Repo.HTMLURL .Release.Repo.FullName}}
            {{.locale.Tr "mail.release.new.text" .Release.Publisher.Name $release_url $repo_url}}

            <h4 style="color:#00d4ff;">{{.locale.Tr "mail.release.title" .Release.Title}}</h4>

            {{if .Release.RenderedNote}}
              {{.locale.Tr "mail.release.note"}}
              <br>
              <div>{{.Release.RenderedNote}}</div>
            {{end}}

            <p style="color:#cbd5e1;">{{.locale.Tr "mail.release.downloads"}}</p>
            <ul>
              {{if not .DisableDownloadSourceArchives}}
                <li><a href="{{.Release.Repo.HTMLURL}}/archive/{{.Release.TagName | PathEscapeSegments}}.zip">{{.locale.Tr "mail.release.download.zip"}}</a></li>
                <li><a href="{{.Release.Repo.HTMLURL}}/archive/{{.Release.TagName | PathEscapeSegments}}.tar.gz">{{.locale.Tr "mail.release.download.targz"}}</a></li>
              {{end}}
              {{if .Release.Attachments}}
                {{range .Release.Attachments}}
                  <li><a href="{{.DownloadURL}}">{{.Name}} ({{.Size | FileSize}})</a></li>
                {{end}}
              {{end}}
            </ul>
          </p>

          <p class="email-subtext"></p>

        </td>
      </tr>

      <!-- Divider -->
      <tr>
        <td class="email-divider"></td>
      </tr>

      <!-- Button & Link -->
      <tr>
        <td class="email-btn-row">

          <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-btn-table">
            <tr>
              <td align="center">
                <a href="{{.Link}}" class="email-btn">{{.locale.Tr "mail.view_it_on" AppName}}</a>
              </td>
            </tr>
          </table>

          <table width="100%" cellpadding="0" cellspacing="0" border="0" class="email-link-box">
            <tr>
              <td style="padding:14px 16px;">
                <p class="email-link-label">{{.locale.Tr "mail.link_not_working_do_paste"}}</p>
                <p class="email-link-url">{{.Link}}</p>
              </td>
            </tr>
          </table>

        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td class="email-footer">

          <p class="email-footer-text">
            &copy;
            <a href="{{AppUrl}}" class="email-footer-link">{{AppName}}</a>
            &mdash; Gitea Mail Templates
          </p>

        </td>
      </tr>

    </table>
  </center>
</body>
</html>