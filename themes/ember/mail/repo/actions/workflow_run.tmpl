<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />

  <title>
    {{.Subject}}
  </title>

  <style type="text/css">
    /* Base */
    body,.ExternalClass,.ReadMsgBody { background-color:#fff7ed }

    /* Header */
    .email-logo { display:inline-block;vertical-align:middle;margin:0 10px;border:0;outline:none }
    .email-brand { font-size:20px;font-weight:700;color:#9a3412;letter-spacing:-0.3px;vertical-align:middle;font-family:Georgia,'Times New Roman',serif }
    .email-header { padding:28px 32px 16px;border-bottom:1px solid #fed7aa;background:linear-gradient(135deg,#fff7ed,#ffffff) }

    /* Card */
    .email-card { max-width:600px;margin:20px auto;background:#ffffff;border-radius:16px;box-shadow:0 2px 16px rgba(234,88,12,0.08);overflow:hidden;border:1px solid #fed7aa }
    .email-heading { font-size:19px;font-weight:700;color:#9a3412;margin:0 0 16px;font-family:Georgia,'Times New Roman',serif }

    /* Content */
    .job-list { list-style:none;padding:0;margin:0 0 24px 0 }
    .job-item { background-color:#fff7ed;border:1px solid #fed7aa;border-radius:10px;padding:12px 16px;margin-bottom:8px }
    .job-link { color:#c2410c;text-decoration:none;font-weight:600;font-size:15px;display:block }

    /* Button */
    .email-btn-row { margin:16px 0 24px;border-collapse:separate }
    .email-btn { display:inline-block;padding:14px 40px;font-size:16px;font-weight:600;color:#ffffff;text-decoration:none;background:linear-gradient(135deg,#ea580c,#c2410c);border-radius:50px;font-family:system-ui,sans-serif }

    /* Fallback link */
    .email-link-box { background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:16px 18px;margin:24px 0 16px }
    .email-link-label { margin:0 0 8px;font-size:14px;color:#92400e;line-height:1.5 }
    .email-link-url { margin:0;font-size:13px;color:#c2410c;background:#ffffff;padding:10px 12px;border-radius:8px;border:1px solid #fed7aa;word-break:break-all;font-family:monospace }

    /* Footer */
    .email-footer { padding:20px 32px 24px;background:#fff7ed;border-top:1px solid #fed7aa }
    .email-footer-text { margin:0;font-size:14px;color:#92400e }
    .email-footer-link { color:#ea580c;text-decoration:none;font-weight:600 }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#fff7ed;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <center style="width:100%;table-layout:fixed;">
    <div class="email-card">

      <!-- Floating Title -->
      <div class="email-header">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
          <tr>
            <td style="vertical-align:middle;">
              <span style="font-size:15px;">&#x1f44b;</span>
              <img src="{{AppUrl}}assets/img/favicon.png" alt="logo" width="30" height="30" class="email-logo" />
              <span class="email-brand">{{AppName}}</span>
            </td>
          </tr>
        </table>
      </div>

      <!-- Card -->
      <div style="padding:32px 32px 24px;color:#78350f;">

        <h2 class="email-heading">
          {{.Repo.FullName}} &mdash; {{.Run.WorkflowID}}: {{.RunStatusText}}
        </h2>

        <ul class="job-list">
        {{range $job := .Jobs}}
          <li class="job-item">
            <a href="{{$job.HTMLURL}}" class="job-link">
              {{$job.Status}}: {{$job.Name}}{{if gt $job.Attempt 1}} (retry #{{$job.Attempt}}){{end}} &mdash; {{$job.Duration}}
            </a>
          </li>
        {{end}}
        </ul>

        <!-- Button -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-btn-row">
          <tr>
            <td align="center">
              <a href="{{.Run.HTMLURL}}" class="email-btn">{{.locale.Tr "mail.view_it_on" AppName}}</a>
            </td>
          </tr>
        </table>

        <!-- Fallback link -->
        <div class="email-link-box">
          <p class="email-link-label">{{.locale.Tr "mail.link_not_working_do_paste"}}</p>
          <p class="email-link-url">{{.Run.HTMLURL}}</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="email-footer">
        <p class="email-footer-text">
          &copy;
          <a href="{{AppUrl}}" class="email-footer-link">{{AppName}}</a>
          &mdash; Gitea Mail Templates
        </p>
      </div>

    </div>
  </center>
</body>
</html>