<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />

  <title>
    {{.Subject}}
  </title>

  <style type="text/css">
    /* Base */
    body,.ExternalClass,.ReadMsgBody { background-color:#fff7ed }

    /* Header */
    .email-logo { display:inline-block;vertical-align:middle;margin:0 10px;border:0;outline:none }
    .email-brand { font-size:20px;font-weight:700;color:#9a3412;letter-spacing:-0.3px;vertical-align:middle;font-family:Georgia,'Times New Roman',serif }
    .email-header { padding:28px 32px 16px;border-bottom:1px solid #fed7aa;background:linear-gradient(135deg,#fff7ed,#ffffff) }

    /* Card */
    .email-card { max-width:600px;margin:20px auto;background:#ffffff;border-radius:16px;box-shadow:0 2px 16px #ea580c14;overflow:hidden;border:1px solid #fed7aa }
    .email-text { margin:0 0 16px;font-size:16px;line-height:1.6;color:#78350f }

    /* Content */
    blockquote { padding-left:1em;margin:1em 0;border-left:3px solid #fdba74;color:#92400e }
    pre { background:#fff7ed;padding:12px;border-radius:8px;overflow-x:auto;font-size:14px;line-height:1.5;border:1px solid #fed7aa }
    hr { border:none;border-top:1px solid #fed7aa;margin:20px 0 }
    .review-path { margin:8px 0;font-size:14px;color:#92400e }
    .review-content { padding-left:1em;margin:1em 0 }
    .review-body { margin-top:8px;font-size:15px;line-height:1.6 }
    .commit-list { margin:16px 0;padding-left:20px }
    .commit-item { margin-bottom:6px;font-size:15px }
    .commit-link { color:#ea580c;text-decoration:none;font-weight:600 }

    /* Button */
    .email-btn-row { margin:28px 0 24px;border-collapse:separate }
    .email-btn { display:inline-block;padding:14px 40px;font-size:16px;font-weight:600;color:#ffffff!important;text-decoration:none;background:linear-gradient(135deg,#ea580c,#c2410c);border-radius:50px;font-family:system-ui,sans-serif }

    /* Fallback link */
    .email-link-box { background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:16px 18px;margin:24px 0 16px }
    .email-link-label { margin:0 0 8px;font-size:14px;color:#92400e;line-height:1.5 }
    .email-link-url { margin:0;font-size:13px;color:#c2410c;background:#ffffff;padding:10px 12px;border-radius:8px;border:1px solid #fed7aa;word-break:break-all;font-family:monospace }

    /* Footer */
    .email-footer { padding:20px 32px 24px;background:#fff7ed;border-top:1px solid #fed7aa }
    .email-footer-text { margin:0;font-size:14px;color:#92400e }
    .email-footer-link { color:#ea580c;text-decoration:none;font-weight:600 }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#fff7ed;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <center style="width:100%;table-layout:fixed;">
    <div class="email-card">

      <!-- Floating Title -->
      <div class="email-header">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
          <tr>
            <td style="vertical-align:middle;">
              <span style="font-size:15px;">&#x1f44b;</span>
              <img src="{{AppUrl}}assets/img/favicon.png" alt="logo" width="30" height="30" class="email-logo" />
              <span class="email-brand">{{AppName}}</span>
            </td>
          </tr>
        </table>
      </div>

      <!-- Card -->
      <div style="padding:32px 32px 24px;color:#78350f;">
        {{if .IsMention}}
          <p class="email-text">{{.locale.Tr "mail.issue.x_mentioned_you" .Doer.Name}}</p>
        {{end}}
        {{if eq .ActionName "push"}}
          <p class="email-text">
          {{if .Comment.IsForcePush}}
            {{$oldCommitUrl := printf "%s/commit/%s" .Comment.Issue.PullRequest.BaseRepo.HTMLURL .Comment.OldCommit}}
            {{$oldShortSha := ShortSha .Comment.OldCommit}}
            {{$oldCommitLink := HTMLFormat "<a href='%[1]s' style='color:#ea580c;text-decoration:none;font-weight:600;'>%[2]s</a>" $oldCommitUrl $oldShortSha}}

            {{$newCommitUrl := printf "%s/commit/%s" .Comment.Issue.PullRequest.BaseRepo.HTMLURL .Comment.NewCommit}}
            {{$newShortSha := ShortSha .Comment.NewCommit}}
            {{$newCommitLink := HTMLFormat "<a href='%[1]s' style='color:#ea580c;text-decoration:none;font-weight:600;'>%[2]s</a>" $newCommitUrl $newShortSha}}

            {{.locale.Tr "mail.issue.action.force_push" .Doer.Name .Comment.Issue.PullRequest.HeadBranch $oldCommitLink $newCommitLink}}
          {{else}}
            {{.locale.TrN (len .Comment.Commits) "mail.issue.action.push_1" "mail.issue.action.push_n" .Doer.Name .Comment.Issue.PullRequest.HeadBranch (len .Comment.Commits)}}
          {{end}}
          </p>
        {{end}}
        <p class="email-text">
        {{if eq .ActionName "close"}}
          {{.locale.Tr "mail.issue.action.close" .Doer.Name .Issue.Index}}
        {{else if eq .ActionName "reopen"}}
          {{.locale.Tr "mail.issue.action.reopen" .Doer.Name .Issue.Index}}
        {{else if eq .ActionName "merge"}}
          {{.locale.Tr "mail.issue.action.merge" .Doer.Name .Issue.Index .Issue.PullRequest.BaseBranch}}
        {{else if eq .ActionName "approve"}}
          {{.locale.Tr "mail.issue.action.approve" .Doer.Name}}
        {{else if eq .ActionName "reject"}}
          {{.locale.Tr "mail.issue.action.reject" .Doer.Name}}
        {{else if eq .ActionName "review"}}
          {{.locale.Tr "mail.issue.action.review" .Doer.Name}}
        {{else if eq .ActionName "review_dismissed"}}
          {{.locale.Tr "mail.issue.action.review_dismissed" .Doer.Name .Comment.Review.Reviewer.Name}}
        {{else if eq .ActionName "ready_for_review"}}
          {{.locale.Tr "mail.issue.action.ready_for_review" .Doer.Name}}
        {{end}}

        {{- if eq .Body ""}}
          {{if eq .ActionName "new"}}
            {{.locale.Tr "mail.issue.action.new" .Doer.Name .Issue.Index}}
          {{end}}
        {{else}}
          {{.Body}}
        {{end -}}
        </p>

        {{- range .ReviewComments}}
          <hr>
          <p class="review-path">{{$.locale.Tr "mail.issue.in_tree_path" .TreePath}}</p>
          <div class="review-content">
            <pre>{{.Patch}}</pre>
            <div class="review-body">{{.RenderedContent}}</div>
          </div>
        {{end -}}

        {{if eq .ActionName "push"}}
          <ul class="commit-list">
          {{range .Comment.Commits}}
            <li class="commit-item">
              <a href="{{$.Comment.Issue.PullRequest.BaseRepo.HTMLURL}}/commit/{{.ID}}" class="commit-link">
                {{ShortSha .ID.String}}
              </a>  &mdash;  {{.UserCommit.GitCommit.MessageTitle}}
            </li>
          {{end}}
          </ul>
        {{end}}

        <!-- Button -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-btn-row">
          <tr>
            <td align="center">
              <a href="{{.Link}}" class="email-btn">{{.locale.Tr "mail.view_it_on" AppName}}</a>
            </td>
          </tr>
        </table>

        <!-- Fallback link -->
        <div class="email-link-box">
          <p class="email-link-label">{{.locale.Tr "mail.link_not_working_do_paste"}}</p>
          <p class="email-link-url">{{.Link}}</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="email-footer">
        <p class="email-footer-text">
          &copy;
          <a href="{{AppUrl}}" class="email-footer-link">{{AppName}}</a>
          {{if .CanReply}}&nbsp;{{.locale.Tr "mail.reply"}}{{end}}
        </p>
      </div>

    </div>
  </center>
</body>
</html>