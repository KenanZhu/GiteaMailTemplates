<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />

  <title>
    {{.locale.Tr "mail.reset_password.title" (.DisplayName|DotEscape)}}
  </title>

  <style type="text/css">
    /* Base */
    body,.ExternalClass,.ReadMsgBody { background-color:#0a0815 }
    .email-wrap { max-width:600px;margin:40px auto;font-family:system-ui,-apple-system,sans-serif }

    /* Header */
    .email-logo { display:block;margin:0 auto 14px;border:0;outline:none;opacity:0.5 }
    .email-brand { font-size:16px;font-weight:300;color:#ffffff66;letter-spacing:4px;text-transform:uppercase }
    .email-header { padding:0 0 32px;text-align:center }

    /* Card */
    .email-card { padding:48px 40px;background:#191432cc;border:1px solid #0d948833;box-shadow:0 0 60px #0d948814,0 0 120px #6366f10a }
    .email-heading { margin:0 0 20px;font-size:24px;font-weight:300;color:#ccfbf1;line-height:1.3;letter-spacing:-.5px }
    .email-text { margin:0 0 24px;font-size:14px;line-height:2;color:#d2fcf5e0;font-weight:300 }
    .email-subtext { margin:0;font-size:13px;line-height:1.8;color:#b4c3d7f2;font-weight:300 }

    /* Divider */
    .email-divider { height:1px;background:linear-gradient(90deg,transparent,#0d94884d,transparent) }

    /* Button */
    .email-btn-row { padding:40px 40px;text-align:center }
    .email-btn { display:inline-block;padding:16px 48px;font-size:14px;font-weight:400;color:#e0f5f3!important;text-decoration:none;background:#0d94882e;border:1px solid #0d94884d;letter-spacing:1px }
    .email-btn-table { margin:0 0 32px }

    /* Fallback link */
    .email-link-box { border:1px solid #0d94882e;background:#0d948808 }
    .email-link-label { margin:0 0 8px;font-size:11px;color:#b4fceebf;font-weight:300 }
    .email-link-url { margin:0;font-size:11px;font-family:monospace;color:#99f6e4;background:#00000033;padding:10px 12px;border:1px solid #0d948826;word-break:break-all }

    /* Footer */
    .email-footer { padding:32px 0 0;text-align:center }
    .email-footer-text { margin:0;font-size:11px;color:#a0afc88c;font-weight:300 }
    .email-footer-link { color:#5eead480;text-decoration:none;font-weight:400 }

    /* Typography utilities */
    .card-body h1,.card-body h2,.card-body h3,.card-body h4,.card-body h5,.card-body h6 { color:#ccfbf1!important }
    .card-body a,.card-body a:link,.card-body a:visited { color:#5eead4!important;text-decoration:underline!important }
    .card-body a:hover,.card-body a:active { color:#99f6e4!important }
    .card-body li { color:#d2fcf5e0!important }

    /* Responsive */
    @media only screen and (max-width:480px) {
      .email-card { padding:32px 20px!important }
      .email-btn-row { padding:24px 20px!important }
      .email-heading { font-size:20px!important }
    }
  </style>
</head>

<body style="margin:0;padding:0;background:#0a0815;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <center style="width:100%;table-layout:fixed;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" class="email-wrap">

      <!-- Floating Title -->
      <tr>
        <td class="email-header">

          <img src="{{AppUrl}}assets/img/favicon.png" alt="logo" width="24" height="24" class="email-logo" />
          <span class="email-brand">{{AppName}}</span>

        </td>
      </tr>

      <!-- Card -->
      <tr>
        <td class="email-card card-body">

          <p class="email-heading">
            {{.locale.Tr "mail.hi_user_x" (.DisplayName|DotEscape)}}
          </p>

          <p class="email-text">
            {{.locale.Tr "mail.reset_password.text" .ResetPwdCodeLives}}
          </p>

          <p class="email-subtext"></p>

        </td>
      </tr>

      <!-- Divider -->
      <tr>
        <td class="email-divider"></td>
      </tr>

      <!-- Button & Link -->
      <tr>
        <td class="email-btn-row">

          {{$recover_url := printf "%suser/recover_account?code=%s" AppUrl (QueryEscape .Code)}}

          <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-btn-table">
            <tr>
              <td align="center">
                <a href="{{$recover_url}}" class="email-btn">{{.locale.Tr "mail.reset_password"}}</a>
              </td>
            </tr>
          </table>

          <table width="100%" cellpadding="0" cellspacing="0" border="0" class="email-link-box">
            <tr>
              <td style="padding:16px 18px;">
                <p class="email-link-label">{{.locale.Tr "mail.link_not_working_do_paste"}}</p>
                <p class="email-link-url">{{$recover_url}}</p>
              </td>
            </tr>
          </table>

        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td class="email-footer">

          <p class="email-footer-text">
            &copy;
            <a href="{{AppUrl}}" class="email-footer-link">{{AppName}}</a>
          </p>

        </td>
      </tr>

    </table>
  </center>
</body>
</html>
