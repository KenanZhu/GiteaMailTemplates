<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />

  <title>
    {{.Subject}}
  </title>

  <style type="text/css">
    /* Base */
    body,.ExternalClass,.ReadMsgBody { background-color:#faf8f5 }

    /* Header */
    .email-logo { display:inline-block;margin:0 auto 12px;border:0;outline:none }
    .email-brand { margin:0;font-size:20px;font-weight:700;color:#1e3a5f;letter-spacing:2px;font-variant:small-caps;font-family:Georgia,'Times New Roman',serif }
    .email-header { padding:32px 36px 20px;text-align:center;border-bottom:1px solid #c4a97d }

    /* Card */
    .email-card { max-width:600px;margin:24px auto;background:#ffffff;border:3px double #c4a97d;padding:0 }
    .email-heading { margin:20px 0 8px;font-size:19px;font-weight:700;color:#1e3a5f;font-family:Georgia,'Times New Roman',serif }
    .email-subheading { margin:20px 0 8px;font-weight:600;color:#1e3a5f;font-variant:small-caps;letter-spacing:1px }
    .email-text { margin:0 0 16px;font-size:16px;line-height:1.7;color:#2c1810 }

    /* Content */
    blockquote { padding-left:1em;margin:1em 0;border-left:2px solid #c4a97d;color:#5c4a3a;font-style:italic }
    ul { margin:12px 0 16px;padding-left:20px }
    li { margin-bottom:8px;font-size:15px;line-height:1.5;color:#2c1810 }
    .email-content { margin:12px 0 16px;font-size:15px;line-height:1.7;color:#2c1810 }

    /* Button */
    .email-btn-row { margin:16px 0 24px;border-collapse:separate }
    .email-btn { display:inline-block;padding:13px 38px;font-size:15px;font-weight:600;color:#ffffff!important;text-decoration:none;background-color:#1e3a5f;border:2px solid #8b6914;font-family:Georgia,'Times New Roman',serif;font-variant:small-caps;letter-spacing:1px }

    /* Fallback link */
    .email-link-box { background:#faf8f5;border:2px solid #d4c4a8;padding:16px 18px;margin:24px 0 16px }
    .email-link-label { margin:0 0 8px;font-size:14px;color:#5c4a3a;line-height:1.5;font-style:italic }
    .email-link-url { margin:0;font-size:13px;color:#1e3a5f;background:#ffffff;padding:10px 12px;border:1px solid #d4c4a8;word-break:break-all;font-family:monospace }

    /* Footer */
    .email-footer { padding:20px 36px 24px;background:#faf8f5;border-top:3px double #c4a97d;text-align:center }
    .email-footer-text { margin:0;font-size:13px;color:#5c4a3a }
    .email-footer-link { color:#1e3a5f;text-decoration:none;font-weight:600 }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#faf8f5;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <center style="width:100%;table-layout:fixed;">
    <div class="email-card">

      <!-- Floating Title -->
      <div class="email-header">
        <img src="{{AppUrl}}assets/img/favicon.png" alt="logo" width="40" height="40" class="email-logo" />
        <p class="email-brand">{{AppName}}</p>
      </div>

      <!-- Card -->
      <div style="padding:32px 36px 24px;color:#2c1810;">
        {{$release_url := HTMLFormat "<a href='%s' style='color:#1e3a5f;text-decoration:none;font-weight:600;border-bottom:1px dotted #8b6914;'>%s</a>" .Release.HTMLURL .Release.TagName}}
        {{$repo_url := HTMLFormat "<a href='%s' style='color:#1e3a5f;text-decoration:none;font-weight:600;border-bottom:1px dotted #8b6914;'>%s</a>" .Release.Repo.HTMLURL .Release.Repo.FullName}}
        <p class="email-text">
          {{.locale.Tr "mail.release.new.text" .Release.Publisher.Name $release_url $repo_url}}
        </p>

        <h4 class="email-heading">{{.locale.Tr "mail.release.title" .Release.Title}}</h4>

        <p style="margin:0 0 8px;font-weight:600;color:#1e3a5f;font-style:italic;">{{.locale.Tr "mail.release.note"}}</p>
        {{if .Release.RenderedNote}}
          <div class="email-content">
            {{.Release.RenderedNote}}
          </div>
        {{end}}

        <p class="email-subheading">{{.locale.Tr "mail.release.downloads"}}</p>
        <ul>
          {{if not .DisableDownloadSourceArchives}}
          <li>
            <a href="{{.Release.Repo.HTMLURL}}/archive/{{.Release.TagName | PathEscapeSegments}}.zip" rel="nofollow" style="color:#1e3a5f;text-decoration:none;font-weight:600;border-bottom:1px dotted #8b6914;">{{.locale.Tr "mail.release.download.zip"}}</a>
          </li>
          <li>
            <a href="{{.Release.Repo.HTMLURL}}/archive/{{.Release.TagName | PathEscapeSegments}}.tar.gz" rel="nofollow" style="color:#1e3a5f;text-decoration:none;font-weight:600;border-bottom:1px dotted #8b6914;">{{.locale.Tr "mail.release.download.targz"}}</a>
          </li>
          {{end}}
          {{if .Release.Attachments}}
            {{range .Release.Attachments}}
              <li>
                <a href="{{.DownloadURL}}" target="_blank" style="color:#1e3a5f;text-decoration:none;font-weight:600;border-bottom:1px dotted #8b6914;">{{.Name}} ({{.Size | FileSize}})</a>
              </li>
            {{end}}
          {{end}}
        </ul>

        <!-- Button -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-btn-row">
          <tr>
            <td align="center">
              <a href="{{.Link}}" class="email-btn">{{.locale.Tr "mail.view_it_on" AppName}}</a>
            </td>
          </tr>
        </table>

        <!-- Fallback link -->
        <div class="email-link-box">
          <p class="email-link-label">{{.locale.Tr "mail.link_not_working_do_paste"}}</p>
          <p class="email-link-url">{{.Link}}</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="email-footer">
        <p class="email-footer-text">
          &copy;
          <a href="{{AppUrl}}" class="email-footer-link">{{AppName}}</a>
        </p>
      </div>

    </div>
  </center>
</body>
</html>