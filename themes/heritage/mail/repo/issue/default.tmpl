<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />

  <title>
    {{.Subject}}
  </title>

  <style type="text/css">
    /* Base */
    body,.ExternalClass,.ReadMsgBody { background-color:#faf8f5 }

    /* Header */
    .email-logo { display:inline-block;margin:0 auto 12px;border:0;outline:none }
    .email-brand { margin:0;font-size:20px;font-weight:700;color:#1e3a5f;letter-spacing:2px;font-variant:small-caps;font-family:Georgia,'Times New Roman',serif }
    .email-header { padding:32px 36px 20px;text-align:center;border-bottom:1px solid #c4a97d }

    /* Card */
    .email-card { max-width:600px;margin:24px auto;background:#ffffff;border:3px double #c4a97d;padding:0 }
    .email-text { margin:0 0 16px;font-size:16px;line-height:1.7;color:#2c1810 }

    /* Content */
    blockquote { padding-left:1em;margin:1em 0;border-left:2px solid #c4a97d;color:#5c4a3a;font-style:italic }
    pre { background:#faf8f5;padding:12px;overflow-x:auto;font-size:14px;line-height:1.5;border:1px solid #d4c4a8 }
    hr { border:none;border-top:1px solid #c4a97d;margin:20px 0 }
    .review-path { margin:8px 0;font-size:14px;color:#5c4a3a;font-style:italic }
    .review-content { padding-left:1em;margin:1em 0 }
    .review-body { margin-top:8px;font-size:15px;line-height:1.7 }
    .commit-list { margin:16px 0;padding-left:20px }
    .commit-item { margin-bottom:6px;font-size:15px }
    .commit-link { color:#1e3a5f;text-decoration:none;font-weight:600;border-bottom:1px dotted #8b6914 }

    /* Button */
    .email-btn-row { margin:28px 0 24px;border-collapse:separate }
    .email-btn { display:inline-block;padding:13px 38px;font-size:15px;font-weight:600;color:#ffffff!important;text-decoration:none;background-color:#1e3a5f;border:2px solid #8b6914;font-family:Georgia,'Times New Roman',serif;font-variant:small-caps;letter-spacing:1px }

    /* Fallback link */
    .email-link-box { background:#faf8f5;border:2px solid #d4c4a8;padding:16px 18px;margin:24px 0 16px }
    .email-link-label { margin:0 0 8px;font-size:14px;color:#5c4a3a;line-height:1.5;font-style:italic }
    .email-link-url { margin:0;font-size:13px;color:#1e3a5f;background:#ffffff;padding:10px 12px;border:1px solid #d4c4a8;word-break:break-all;font-family:monospace }

    /* Footer */
    .email-footer { padding:20px 36px 24px;background:#faf8f5;border-top:3px double #c4a97d;text-align:center }
    .email-footer-text { margin:0;font-size:13px;color:#5c4a3a }
    .email-footer-link { color:#1e3a5f;text-decoration:none;font-weight:600 }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#faf8f5;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <center style="width:100%;table-layout:fixed;">
    <div class="email-card">

      <!-- Floating Title -->
      <div class="email-header">
        <img src="{{AppUrl}}assets/img/favicon.png" alt="logo" width="40" height="40" class="email-logo" />
        <p class="email-brand">{{AppName}}</p>
      </div>

      <!-- Card -->
      <div style="padding:32px 36px 24px;color:#2c1810;">
        {{if .IsMention}}
          <p class="email-text">{{.locale.Tr "mail.issue.x_mentioned_you" .Doer.Name}}</p>
        {{end}}
        {{if eq .ActionName "push"}}
          <p class="email-text">
          {{if .Comment.IsForcePush}}
            {{$oldCommitUrl := printf "%s/commit/%s" .Comment.Issue.PullRequest.BaseRepo.HTMLURL .Comment.OldCommit}}
            {{$oldShortSha := ShortSha .Comment.OldCommit}}
            {{$oldCommitLink := HTMLFormat "<a href='%[1]s' style='color:#1e3a5f;text-decoration:none;font-weight:600;border-bottom:1px dotted #8b6914;'>%[2]s</a>" $oldCommitUrl $oldShortSha}}

            {{$newCommitUrl := printf "%s/commit/%s" .Comment.Issue.PullRequest.BaseRepo.HTMLURL .Comment.NewCommit}}
            {{$newShortSha := ShortSha .Comment.NewCommit}}
            {{$newCommitLink := HTMLFormat "<a href='%[1]s' style='color:#1e3a5f;text-decoration:none;font-weight:600;border-bottom:1px dotted #8b6914;'>%[2]s</a>" $newCommitUrl $newShortSha}}

            {{.locale.Tr "mail.issue.action.force_push" .Doer.Name .Comment.Issue.PullRequest.HeadBranch $oldCommitLink $newCommitLink}}
          {{else}}
            {{.locale.TrN (len .Comment.Commits) "mail.issue.action.push_1" "mail.issue.action.push_n" .Doer.Name .Comment.Issue.PullRequest.HeadBranch (len .Comment.Commits)}}
          {{end}}
          </p>
        {{end}}
        <p class="email-text">
        {{if eq .ActionName "close"}}
          {{.locale.Tr "mail.issue.action.close" .Doer.Name .Issue.Index}}
        {{else if eq .ActionName "reopen"}}
          {{.locale.Tr "mail.issue.action.reopen" .Doer.Name .Issue.Index}}
        {{else if eq .ActionName "merge"}}
          {{.locale.Tr "mail.issue.action.merge" .Doer.Name .Issue.Index .Issue.PullRequest.BaseBranch}}
        {{else if eq .ActionName "approve"}}
          {{.locale.Tr "mail.issue.action.approve" .Doer.Name}}
        {{else if eq .ActionName "reject"}}
          {{.locale.Tr "mail.issue.action.reject" .Doer.Name}}
        {{else if eq .ActionName "review"}}
          {{.locale.Tr "mail.issue.action.review" .Doer.Name}}
        {{else if eq .ActionName "review_dismissed"}}
          {{.locale.Tr "mail.issue.action.review_dismissed" .Doer.Name .Comment.Review.Reviewer.Name}}
        {{else if eq .ActionName "ready_for_review"}}
          {{.locale.Tr "mail.issue.action.ready_for_review" .Doer.Name}}
        {{end}}

        {{- if eq .Body ""}}
          {{if eq .ActionName "new"}}
            {{.locale.Tr "mail.issue.action.new" .Doer.Name .Issue.Index}}
          {{end}}
        {{else}}
          {{.Body}}
        {{end -}}
        </p>

        {{- range .ReviewComments}}
          <hr>
          <p class="review-path">{{$.locale.Tr "mail.issue.in_tree_path" .TreePath}}</p>
          <div class="review-content">
            <pre>{{.Patch}}</pre>
            <div class="review-body">{{.RenderedContent}}</div>
          </div>
        {{end -}}

        {{if eq .ActionName "push"}}
          <ul class="commit-list">
          {{range .Comment.Commits}}
            <li class="commit-item">
              <a href="{{$.Comment.Issue.PullRequest.BaseRepo.HTMLURL}}/commit/{{.ID}}" class="commit-link">
                {{ShortSha .ID.String}}
              </a>  &mdash;  {{.UserCommit.GitCommit.MessageTitle}}
            </li>
          {{end}}
          </ul>
        {{end}}

        <!-- Button -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-btn-row">
          <tr>
            <td align="center">
              <a href="{{.Link}}" class="email-btn">{{.locale.Tr "mail.view_it_on" AppName}}</a>
            </td>
          </tr>
        </table>

        <!-- Fallback link -->
        <div class="email-link-box">
          <p class="email-link-label">{{.locale.Tr "mail.link_not_working_do_paste"}}</p>
          <p class="email-link-url">{{.Link}}</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="email-footer">
        <p class="email-footer-text">
          &copy;
          <a href="{{AppUrl}}" class="email-footer-link">{{AppName}}</a>
          {{if .CanReply}}&nbsp;{{.locale.Tr "mail.reply"}}{{end}}
        </p>
      </div>

    </div>
  </center>
</body>
</html>